{
  "Logging": {
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft": "Error"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always",
    "AttachStackTrace": true,
    "TracesSampleRate": 0.2
  },
  "ConnectionStrings": {
    "WebApiDatabase": "Data Source=./LocalDatabase.db"
  },
  "PaydayOptions": {
    "DayOfMonth": 25
  },
  "BankHolidayApiOptions": {
    "Url": "https://www.gov.uk/bank-holidays.json",
    "Region": "england-and-wales"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
